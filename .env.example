# Copy this file to .env and fill in the values.  .env is gitignored - never commit it.

# ---------------------------------------------------------------------------
# Anthropic - resume tailoring + email drafting
#   Key: https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# claude-opus-5 (best quality) or claude-sonnet-5 (cheaper, still strong)
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Contacts - find people at the target company
#   CONTACTS_PROVIDER: hunter | apollo | auto | none
#     hunter - free tier: 25 searches/month, returns names + titles + emails.
#              Key: https://hunter.io/api-keys      (recommended)
#     apollo - SEARCH endpoints require a PAID plan (free returns HTTP 403).
#              The organizations/enrich endpoint used for domain lookup is free.
#              Key: https://app.apollo.io/#/settings/integrations/api
#     auto   - try apollo, fall back to hunter
#     none   - skip contact lookup
# ---------------------------------------------------------------------------
CONTACTS_PROVIDER=hunter
HUNTER_API_KEY=
HUNTER_LIMIT=10
APOLLO_API_KEY=

# ---------------------------------------------------------------------------
# Google - Gmail draft + Sheets log (one OAuth client covers both)
#   1. https://console.cloud.google.com -> new project
#   2. Enable "Gmail API" and "Google Sheets API"
#   3. OAuth consent screen: External, add yourself as a Test user
#   4. Credentials -> OAuth client ID -> "Desktop app" -> download JSON
#      -> save as credentials/client_secret.json
#   5. Run:  python authorize.py   (one-time browser consent)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_SECRETS=credentials/client_secret.json
GOOGLE_TOKEN_PATH=credentials/token.json
# Spreadsheet ID (or paste the whole URL - the ID is extracted):
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
LOG_SHEET_ID=
LOG_SHEET_TAB=Applications

# ---------------------------------------------------------------------------
# PDF rendering - install LibreOffice: https://www.libreoffice.org/download/
#   Leave blank to auto-detect; set the full path to soffice(.exe) if needed.
# ---------------------------------------------------------------------------
SOFFICE_PATH=

# ---------------------------------------------------------------------------
# Applicant details - used in the resume header + email signature
# ---------------------------------------------------------------------------
APPLICANT_NAME=Your Name
APPLICANT_EMAIL=you@example.com
APPLICANT_PHONE=
APPLICANT_LOCATION=City, Country
APPLICANT_LINKEDIN=linkedin.com/in/your-handle
APPLICANT_GITHUB=github.com/your-handle

# Your master resume: a comprehensive .docx holding every role/project/bullet.
# The tailoring step only ever selects, reorders and lightly rephrases content
# that already exists in this file.
MASTER_RESUME_PATH=master-resume.docx
OUTPUT_DIR=output

# Roles you are targeting - drives contact-title search and resume emphasis.
TARGET_ROLES=Software Engineer,Data Analyst,Data Scientist,Machine Learning Engineer

# Optional: extra truthful constraints / corrections for the tailoring step (prompt).
# Example: "The degree in progress is an MRes, not an MSc. No AWS certification."
RESUME_CONSTRAINTS=Use ONLY content grounded in the master resume; if a fact is not in it, do not add it.

# Optional belt-and-braces enforcement applied AFTER generation:
#   RESUME_REPLACEMENTS  - literal "old=>new" pairs, ';'-separated
#   RESUME_DROP_PATTERNS - regex; any skill/bullet/cert line matching it is removed
# Example:
#   RESUME_REPLACEMENTS=MSc Foo=>MRes Foo
#   RESUME_DROP_PATTERNS=aws.*certif|working.*towards.*aws
RESUME_REPLACEMENTS=
RESUME_DROP_PATTERNS=
